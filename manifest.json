{
  "manifest_version": 3,
  "name": "Spot Cleaner",
  "version": "0.2.3",
  "description": "استخراج جلسات SpotPlayer، تطبیق فایل‌ها و قرنطینه امن فایل‌های اضافی",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://app.spotplayer.ir/*"
  ],
  "action": {
    "default_title": "Spot Cleaner",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.spotplayer.ir/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
